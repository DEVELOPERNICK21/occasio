# Occasio — copy to .env.development (gitignored). See docs-site/content/env-strategy.md

# Set to enable real API in dev (otherwise mock mode in __DEV__)
# OCCASIO_API_BASE=https://asia-south1-occasio-dev.cloudfunctions.net

# Public share link base (recipient web at /c/[slug])
OCCASIO_SHARE_BASE=https://occasio.vercel.app

# Firebase (add when project is created)
# FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=occasio-dev
