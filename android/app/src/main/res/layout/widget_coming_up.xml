<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Coming up"
            android:textColor="@color/occasio_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quick_wish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="+ Quick wish"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rows_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row1_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_avatar_rose"
                android:gravity="center"
                android:text="M"
                android:textColor="@color/occasio_rose_deep"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/row1_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Mom · Birthday"
                android:textColor="@color/occasio_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/row1_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="3 days"
                android:textColor="@color/occasio_accent_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row2_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_avatar_amber"
                android:gravity="center"
                android:text="P"
                android:textColor="@color/occasio_amber_deep"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/row2_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Partner · Anniversary"
                android:textColor="@color/occasio_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/row2_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="12 days"
                android:textColor="@color/occasio_ink_soft"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row3_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_avatar_rose"
                android:gravity="center"
                android:text="D"
                android:textColor="@color/occasio_rose_deep"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/row3_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Dad · Birthday"
                android:textColor="@color/occasio_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/row3_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="41 days"
                android:textColor="@color/occasio_ink_soft"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add someone you love"
            android:textColor="@color/occasio_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Save their birthday once. We'll keep count."
            android:textColor="@color/occasio_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
