    "firestore:deploy": "npx firebase-tools deploy --only firestore:rules",
    "typecheck": "tsc --noEmit",
    "icons:generate": "bash scripts/generate-app-icons.sh",
    "firebase:deploy": "firebase deploy --only functions,firestore:rules"
  },
