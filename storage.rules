rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/guest/{fileName} {
      // Create-only: nobody can overwrite or delete another person's photo.
      allow create: if request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
      allow read: if true;
    }
  }
}
