# Occasio — copy to .env.development (gitignored). See docs-site/content/env-strategy.md

# Cloud Functions API base — must include /api (function export name)
# Production:
# OCCASIO_API_BASE=https://asia-south1-occasio-app-dev.cloudfunctions.net/api
# Local emulator (docs-site server-side fetch only — use host machine IP from device):
# OCCASIO_API_BASE=http://127.0.0.1:5001/occasio-app-dev/asia-south1/api

# Public share link base (recipient web at /c/[slug])
OCCASIO_SHARE_BASE=https://occasio-greetings.vercel.app

# Firebase project (dev) — matches .firebaserc
FIREBASE_PROJECT_ID=occasio-app-dev

# Firebase web API key — docs-site server-side Firestore reads (set on Vercel, not in mobile .env)
# FIREBASE_WEB_API_KEY=your-web-api-key
