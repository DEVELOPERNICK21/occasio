# Occasio — copy to .env.development (gitignored). See docs-site/content/env-strategy.md

# Cloud Functions API base — must include /api (function export name)
# Production:
# OCCASIO_API_BASE=https://asia-south1-occasio-app-dev.cloudfunctions.net/api
# Local emulator (docs-site server-side fetch only — use host machine IP from device):
# OCCASIO_API_BASE=http://127.0.0.1:5001/occasio-app-dev/asia-south1/api

# Public share link base (recipient web at /c/[slug])
OCCASIO_SHARE_BASE=https://occasio-greetings.vercel.app

# Firebase project (dev) — matches .firebaserc
FIREBASE_PROJECT_ID=occasio-app-dev

# RevenueCat public SDK keys (paste from RevenueCat → Project → Apps)
# Test Store: test_… · Android production: goog_… · iOS: appl_…
# Mobile app also reads src/shared/config/revenueCat.ts
REVENUECAT_TEST_API_KEY=
REVENUECAT_ANDROID_API_KEY=
REVENUECAT_IOS_API_KEY=

# Cloud Functions (set via firebase functions:config or .env for emulator — not read by mobile app)
OCCASIO_CRON_SECRET=              # required for POST /v1/internal/autosend/run (header x-occasio-cron-secret)
OCCASIO_AUTOSEND_DISPATCH=false   # default false — must be exactly true to call mock WA/SMS/email; else stops at approved
OCCASIO_AUTOSEND_ALLOW_FREE=false # dev/emulator only: cron treats all tiers as paid
OCCASIO_MOCK_DELIVERY_FAIL=       # optional: comma-separated channels (whatsapp,sms,email) to force mock failure

# Vercel server API uses FIREBASE_SERVICE_ACCOUNT_JSON (set on Vercel only — see docs-site/content/env-strategy.md)
